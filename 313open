local function disarmCharacter(dyingCharacter, humanoid)
    if not Config.AutoDisarmOnDeath then return end
    if not dyingCharacter then return end
    pickupSuppressUntil = tick() + 3
    pcall(function()
        if humanoid then pcall(function() humanoid:UnequipTools() end) end
        local root = dyingCharacter:FindFirstChild("HumanoidRootPart") or dyingCharacter:FindFirstChild("Head")
        local dropCFrame = root and (root.CFrame + Vector3.new(0, 2, 0)) or CFrame.new(0, 10, 0)
        local now = tick()
        local function dropTool(tool)
            if not tool or not tool.Parent then return end
            local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")
            if handle then
                handle.CFrame = dropCFrame
                handle.CanCollide = true
                handle.AssemblyLinearVelocity = Vector3.new(0, 2, 0)
            end
            tool.Parent = Workspace
            recentlyDroppedTools[tool] = now
        end
        for _, tool in ipairs(dyingCharacter:GetChildren()) do
            if tool:IsA("Tool") then dropTool(tool) end
        end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then dropTool(tool) end
            end
        end
    end)
end

local function hookHumanoid(newChar)
    local humanoid = newChar:FindFirstChildOfClass("Humanoid") or newChar:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    local charRef = newChar
    table.insert(connections, humanoid.Died:Connect(function()
        disarmCharacter(charRef, humanoid)
    end))
end

local function onCharacterAdded(newCharacter)

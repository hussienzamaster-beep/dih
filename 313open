local isDragging = false
local dragStartPos = Vector2.new(0, 0)
local windowStartPos = UDim2.new(0, 0, 0, 0)
local targetPos = nil

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
        windowStartPos = mainWindow.Position
        targetPos = nil
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not isDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local deltaX = input.Position.X - dragStartPos.X
        local deltaY = input.Position.Y - dragStartPos.Y
        targetPos = UDim2.new(
            windowStartPos.X.Scale, windowStartPos.X.Offset + deltaX,
            windowStartPos.Y.Scale, windowStartPos.Y.Offset + deltaY
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if targetPos and mainWindow.Visible then
        local cur = mainWindow.Position
        local curX = cur.X.Scale * mainWindow.Parent.AbsoluteSize.X + cur.X.Offset
        local curY = cur.Y.Scale * mainWindow.Parent.AbsoluteSize.Y + cur.Y.Offset
        local tX = targetPos.X.Scale * mainWindow.Parent.AbsoluteSize.X + targetPos.X.Offset
        local tY = targetPos.Y.Scale * mainWindow.Parent.AbsoluteSize.Y + targetPos.Y.Offset
        local lerpFactor = math.clamp(dt * 22, 0, 1)
        local newX = curX + (tX - curX) * lerpFactor
        local newY = curY + (tY - curY) * lerpFactor
        mainWindow.Position = UDim2.new(0, math.floor(newX), 0, math.floor(newY))
        if not isDragging and math.abs(tX - newX) < 0.5 and math.abs(tY - newY) < 0.5 then
            mainWindow.Position = targetPos
            targetPos = nil
        end
    end
end)


local cachedDeleteParts = {}
local deleteCacheOrigin = nil
local deleteScanAccum = 0

task.spawn(function()
    while scriptActive do
        task.wait(0.05)
        if Config.DeleteAura and character and character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local hrp = character.HumanoidRootPart
                local currentPos = hrp.Position
                local now = tick()

                local movedFar = deleteCacheOrigin and (currentPos - deleteCacheOrigin).Magnitude > (Config.AuraRange * 0.4)
                if now - deleteScanAccum >= 0.12 or movedFar or not deleteCacheOrigin then
                    deleteScanAccum = now
                    deleteCacheOrigin = currentPos
                    cachedDeleteParts = getNearbyParts(Config.AuraRange, currentPos)
                end

                local deleteTool = getTool("Delete")
                if not deleteTool then return end

                local origEvent = deleteTool:FindFirstChild("origevent")
                local scriptEvent = deleteTool:FindFirstChild("Script") and deleteTool.Script:FindFirstChild("Event")
                if not origEvent and not scriptEvent then return end

                if Config.DeleteTPMode then
                    local fired = 0
                    for i = 1, #cachedDeleteParts do
                        if not Config.DeleteAura or not Config.DeleteTPMode then break end
                        local part = cachedDeleteParts[i]
                        if part and part.Parent and part:IsA("BasePart") then
                            local hrpLive = character:FindFirstChild("HumanoidRootPart")
                            if not hrpLive then break end
                            local partPos = part.Position
                            local offset = Vector3.new(0, Config.DeleteTPOffset, 0)
                            local targetCFrame = CFrame.new(partPos + offset)
                            pcall(function() hrpLive.CFrame = targetCFrame end)
                            task.wait(0.02)
                            if origEvent then
                                pcall(function() origEvent:Invoke(part, partPos) end)
                            else
                                pcall(function() scriptEvent:FireServer(part, partPos) end)
                            end
                            fired = fired + 1
                            if fired >= 4 then break end
                        end
                    end
                else
                    for i = 1, #cachedDeleteParts do
                        if not Config.DeleteAura then break end
                        local part = cachedDeleteParts[i]
                        if part and part.Parent and part:IsA("BasePart") then
                            if origEvent then
                                pcall(function() origEvent:Invoke(part, part.Position) end)
                            else
                                pcall(function() scriptEvent:FireServer(part, part.Position) end)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

